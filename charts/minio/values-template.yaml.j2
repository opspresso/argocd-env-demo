{% set storage_gc = storage_gc_maintenance | default(false) %}{% if env == 'local' %}externalSecrets:
  enabled: false
{% else %}global:
  ssmPrefix: /k8s/{{cluster}}
{% endif %}{% if (minio is defined and (minio.buckets is defined or minio.storage is defined or minio.console is defined)) or not resources or not autoscaling or storage_gc %}
minio:
{% if storage_gc %}
  networkPolicy:
    enabled: false
{% endif %}
{% if minio is defined and minio.buckets is defined %}
  defaultBuckets: {{minio.buckets}}
{% endif %}
{% if minio is defined and minio.storage is defined %}
  persistence:
    size: {{minio.storage}}
{% endif %}
{% if not resources %}
  resources: null
  resourcesPreset: none
{% endif %}
{% if not autoscaling %}
  autoscaling:
    vpa:
      enabled: false
{% endif %}
{% if (minio is defined and minio.console is defined) or not resources or not autoscaling %}
  console:
{% if minio is defined and minio.console is defined %}
    enabled: {{minio.console}}
{% endif %}
{% if not resources %}
    resources: null
    resourcesPreset: none
{% endif %}
{% if not autoscaling %}
    autoscaling:
      vpa:
        enabled: false
      hpa:
        enabled: false
{%- endif %}
{%- endif %}
{%- endif %}{% if storage_gc %}
storageGc:
  enabled: true
{% endif %}
