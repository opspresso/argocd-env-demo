{% set maintenance = agent_studio_maintenance | default(false) -%}
app:
  fullnameOverride: agent-studio
{% if agent_studio is defined %}
  replicaCount: {{0 if maintenance else replicas}}
  autoscaling:
    enabled: {{false if maintenance else autoscaling}}
  image:
    repository: {{aws_account_id}}.dkr.ecr.{{aws_region}}.amazonaws.com/agent-studio
{% if env == 'k3s' %}
  imagePullSecrets:
    - name: ecr-registry
{% endif %}
{% if workspace_worker %}
  additionalConfigmap:
    enabled: true
    names:
      - agent-studio-workspace
  extraVolumes:
    - name: ecr-config
      secret:
        secretName: ecr-registry
        items:
          - key: .dockerconfigjson
            path: config.json
  extraVolumeMounts:
    - name: ecr-config
      mountPath: /home/app/.docker
      readOnly: true
{% endif %}
{% if not resources %}
  resources: null
{% endif %}
  configmap:
    enabled: true
    data:
      STAGE: '{{phase}}'
      SERVICE_NAME: 'AgentOps'
      SERVICE_LOGO: 'agentops'
      ADMIN_EMAILS: me@nalbam.com
      # ALLOWED_EMAIL_DOMAINS: nalbam.com
      AWS_REGION: {{aws_region}}
      BETTER_AUTH_URL: https://{{agent_studio.hostname}}
      PUBLIC_BASE_URL: https://{{agent_studio.hostname}}
      S3_BUCKET_NAME: agent-studio-static
{% if env == 'k3s' %}
      S3_ENDPOINT: http://minio.agent-studio.svc.cluster.local:9000
{% endif %}
      ARTIFACT_ACCESS_MODE: proxied
      CATALOG_ENABLED: 'true'
      SLACK_LOADING_INDICATOR: ':loading:'
      TRUSTED_PROXY_CIDRS: 10.10.0.0/16
      EMBEDDING_PROVIDER: openai
{% if env == 'k3s' %}
      EMBEDDING_BASE_URL: http://100.66.249.76:8001/v1
      EMBEDDING_MODEL: selfhosted/Qwen3-Embedding-4B
      EMBEDDING_DIM: native
      CATALOG_MIN_SCORE: '0.24'
      RERANKER_BASE_URL: http://100.66.249.76:8002/v1
      RERANKER_MODEL: selfhosted/Qwen3-Reranker-0.6B
      RERANKER_MIN_SCORE: '0.01'
      LLM_PROVIDER_SELFHOSTED_BASE_URL: http://100.66.249.76:8000/v1
{% else %}
      EMBEDDING_MODEL: openrouter/text-embedding-3-small
      EMBEDDING_DIM: native
      CATALOG_MIN_SCORE: '0.24'
      RERANKER_MODEL: openrouter/rerank-v3.5
      RERANKER_MIN_SCORE: '0.05'
      LLM_PROVIDER_SELFHOSTED_BASE_URL: https://spark-0702.nyala-blenny.ts.net:8443/v1
{% endif %}
      LLM_BASE_URL: https://api.openai.com/v1
      UNKNOWN_MODEL_POLICY: allow
      LLM_PROVIDER_ANTHROPIC_BASE_URL: https://api.anthropic.com/v1
      LLM_PROVIDER_OPENAI_BASE_URL: https://api.openai.com/v1
      LLM_PROVIDER_GOOGLE_BASE_URL: https://generativelanguage.googleapis.com/v1beta/openai
      LLM_PROVIDER_XAI_BASE_URL: https://api.x.ai/v1
      LLM_PROVIDER_OPENROUTER_BASE_URL: https://openrouter.ai/api/v1
      MAX_RUN_DURATION_MS: '600000'
      MCP_INTERNAL_HOST_SUFFIXES: agent-mcps.svc.cluster.local,agent-memory.svc.cluster.local
      PLUGINS_REPO: opspresso/agent-plugins
      PLUGINS_REPO_BRANCH: main
{% if workspace_worker %}
      DOCKER_HOST: tcp://agent-studio-workspace-docker.agent-studio.svc.cluster.local:2375
      WORKSPACE_NETWORK: {{workspace_network}}
      WORKSPACE_GITHUB_AUTH: token
      GITHUB_API_URL: https://api.github.com
      GITHUB_WEB_URL: https://github.com
      WORKSPACE_MEMORY_MB: '{{workspace_memory_mb}}'
      WORKSPACE_DISK_MB: '{{workspace_disk_mb}}'
      WORKSPACE_CPUS: '{{workspace_cpus}}'
      WORKSPACE_WORKER_CONCURRENCY: '{{workspace_worker_concurrency}}'
{% endif %}
  routing:
    hosts:
    - {{agent_studio.hostname}}
    httpRoute:
      enabled: true
{% if env == 'k3s' %}
      parentRefs:
        - name: traefik-gateway
          namespace: traefik-gateway
{% endif %}
{% if env != 'k3s' %}
  podLabels:
    sidecar.istio.io/inject: "true"
{% endif %}
  podAnnotations:
    link.argocd.argoproj.io/external-link: https://{{agent_studio.hostname}}

  serviceMonitor:
    labels:
      release: {{ 'victoria-metrics-' if metrics.backend == 'victoria-metrics' else 'prometheus-' }}{{cluster}}

  externalSecrets:
    enabled: true
    data:
    - key: /k8s/common/agent-studio/better-auth-secret
      name: BETTER_AUTH_SECRET
    - key: /k8s/common/agent-studio/google-client-id
      name: GOOGLE_CLIENT_ID
    - key: /k8s/common/agent-studio/google-client-secret
      name: GOOGLE_CLIENT_SECRET
    - key: /k8s/common/agent-studio/llm-api-key
      name: LLM_API_KEY
    - key: /k8s/common/agent-studio/llm-provider-openai-api-key
      name: LLM_PROVIDER_OPENAI_API_KEY
    - key: /k8s/common/agent-studio/llm-provider-anthropic-api-key
      name: LLM_PROVIDER_ANTHROPIC_API_KEY
    - key: /k8s/common/agent-studio/llm-provider-google-api-key
      name: LLM_PROVIDER_GOOGLE_API_KEY
    - key: /k8s/common/agent-studio/llm-provider-xai-api-key
      name: LLM_PROVIDER_XAI_API_KEY
    - key: /k8s/common/agent-studio/llm-provider-openrouter-api-key
      name: LLM_PROVIDER_OPENROUTER_API_KEY
    - key: /k8s/common/agent-studio/llm-provider-selfhosted-api-key
      name: LLM_PROVIDER_SELFHOSTED_API_KEY
    - key: /k8s/common/agent-studio/aes-encryption-key
      name: AES_ENCRYPTION_KEY
    - key: /k8s/common/agent-studio/a2a-api-key
      name: A2A_API_KEY
    - key: /k8s/common/agent-studio/github-token
      name: GITHUB_TOKEN
    - key: /k8s/common/agent-studio/schedule-scan-token
      name: SCHEDULE_SCAN_TOKEN
    - key: /k8s/{{cluster}}/agent-studio/database-url
      name: DATABASE_URL
{% if env == 'k3s' %}
    - key: /k8s/{{cluster}}/agent-studio/minio-root-user
      name: S3_ACCESS_KEY_ID
    - key: /k8s/{{cluster}}/agent-studio/minio-root-password
      name: S3_SECRET_ACCESS_KEY
{% else %}
    - key: /k8s/common/agent-studio/llm-provider-openai-api-key
      name: EMBEDDING_API_KEY
{% endif %}
scan:
  suspend: {{maintenance}}
{% if not resources %}
  resources: null
{% endif %}

reindex:
  suspend: {{maintenance}}
{% if not resources %}
  resources: null
{% endif %}

{% if audio_worker or workspace_worker %}
{% if audio_worker %}
audioWorker:
  enabled: true
  replicas: {{0 if maintenance else 1}}
{% endif %}
{% if workspace_worker %}
workspaceWorker:
  enabled: true
  replicas: {{0 if maintenance else 1}}
  dockerImage: {{workspace_docker_image}}
  workerConcurrency: {{workspace_worker_concurrency}}
  memoryMb: {{workspace_memory_mb}}
  diskMb: {{workspace_disk_mb}}
  cpus: {{workspace_cpus}}
  persistence:
    size: {{workspace_storage | default('10Gi')}}
    storageClass: {{workspace_storage_class | default('local-path')}}
{% if env == 'eks' %}
  registry:
    enabled: true
    region: {{aws_region}}
{%- endif %}
{%- endif %}
{%- endif %}
{%- endif %}
