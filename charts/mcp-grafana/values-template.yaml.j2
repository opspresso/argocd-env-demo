app:
  replicaCount: {{replicas}}{% if not autoscaling %}
  autoscaling:
    enabled: false{% endif %}
{% if not resources %}
  resources: null
{% endif %}
{% if env == 'eks' %}
  podLabels:
    sidecar.istio.io/inject: "true"
{% endif %}

  configmap:
    enabled: true
    data:
      GRAFANA_URL: {{grafana_url | tojson}}
{% if env != 'eks' %}
  destinationRule:
    enabled: false
{% endif %}
{%- if env == 'local' %}
networkPolicy:
  # Mac clients use local port forwards or direct Service connectivity.
  enabled: false
{% endif %}
