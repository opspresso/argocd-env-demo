app:
  fullnameOverride: agent-memory
{% if agent_memory is defined %}
  replicaCount: {{replicas}}
  autoscaling:
    enabled: {{autoscaling}}
  image:
    repository: {{aws_account_id}}.dkr.ecr.{{aws_region}}.amazonaws.com/agent-memory
{% if env == 'k3s' %}
  imagePullSecrets:
    - name: ecr-registry
{% endif %}
{% if not resources %}
  resources: null
{% endif %}
  configmap:
    enabled: true
    data:
      STAGE: 'prod'
      ADMIN_EMAILS: me@nalbam.com
      # ALLOWED_EMAIL_DOMAINS: nalbam.com
      AWS_REGION: {{aws_region}}
      BETTER_AUTH_URL: https://{{agent_memory.hostname}}
      NEO4J_URI: bolt://memory-neo4j.agent-memory.svc.cluster.local:7687
      NEO4J_USERNAME: neo4j
      NEO4J_DATABASE: neo4j
      S3_REGION: {{aws_region}}
{% if env == 'k3s' %}
      S3_ENDPOINT: http://minio.agent-studio.svc.cluster.local:9000
      S3_BUCKET: agent-memory
      S3_FORCE_PATH_STYLE: 'true'
{% else %}
      S3_BUCKET: agent-studio-static
      S3_FORCE_PATH_STYLE: 'false'
{% endif %}
      EMBEDDING_BASE_URL: https://openrouter.ai/api/v1
      EMBEDDING_MODEL: openai/text-embedding-3-small
      RERANKER_BASE_URL: https://openrouter.ai/api/v1
      RERANKER_MODEL: voyageai/rerank-2.5-lite
      RERANKER_TIMEOUT_MS: '5000'
      RERANKER_MIN_SCORE: '0.35'
      DOCUMENT_WORKER_ENABLED: 'true'
{% if env == 'k3s' %}
      KNOWLEDGE_EXTRACTION_BASE_URL: http://100.66.249.76:8000/v1
      KNOWLEDGE_EXTRACTION_MODEL: nvidia/Qwen3.6-35B-A3B-NVFP4
      KNOWLEDGE_ENRICHMENT_CONCURRENCY: '1'
{% else %}
      KNOWLEDGE_EXTRACTION_BASE_URL: https://openrouter.ai/api/v1
      KNOWLEDGE_EXTRACTION_MODEL: openai/gpt-4.1-mini
      KNOWLEDGE_ENRICHMENT_CONCURRENCY: '4'
{% endif %}
  routing:
    hosts:
    - {{agent_memory.hostname}}
    httpRoute:
      enabled: true
{% if env == 'k3s' %}
      parentRefs:
        - name: traefik-gateway
          namespace: traefik-gateway
{% endif %}
{% if env != 'k3s' %}
  podLabels:
    sidecar.istio.io/inject: "true"
{% endif %}
  podAnnotations:
    link.argocd.argoproj.io/external-link: https://{{agent_memory.hostname}}

  externalSecrets:
    enabled: true
    data:
    - key: /k8s/common/agent-memory/better-auth-secret
      name: BETTER_AUTH_SECRET
    - key: /k8s/common/agent-memory/google-client-id
      name: GOOGLE_CLIENT_ID
    - key: /k8s/common/agent-memory/google-client-secret
      name: GOOGLE_CLIENT_SECRET
    - key: /k8s/common/agent-memory/embedding-api-key
      name: EMBEDDING_API_KEY
    - key: /k8s/common/agent-memory/reranker-api-key
      name: RERANKER_API_KEY
    - key: /k8s/common/agent-memory/knowledge-extraction-api-key
      name: KNOWLEDGE_EXTRACTION_API_KEY
    - key: /k8s/{{cluster}}/agent-memory/database-url
      name: DATABASE_URL
    - key: /k8s/{{cluster}}/agent-memory/neo4j-password
      name: NEO4J_PASSWORD
    - key: /k8s/{{cluster}}/agent-memory/metrics-bearer-token
      name: METRICS_BEARER_TOKEN
{% if env == 'k3s' %}
    - key: /k8s/{{cluster}}/agent-studio/minio-root-user
      name: S3_ACCESS_KEY_ID
    - key: /k8s/{{cluster}}/agent-studio/minio-root-password
      name: S3_SECRET_ACCESS_KEY
{% endif %}

serviceMonitor:
  labels:
    release: {{ 'victoria-metrics-' if metrics.backend == 'victoria-metrics' else 'prometheus-' }}{{cluster}}
{% endif %}
