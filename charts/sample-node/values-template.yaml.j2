app:
  configmap:
    data:
      CLUSTER_NAME: '{{cluster}}'
      HOSTNAME: sample.svc.cluster.local
      MESSAGE: hello world
      PROFILE: '{{env}}'
      PROTOCOL: http
      REDIS_HOST: redis-master
      REDIS_PORT: '6379'
  routing:
    hosts:
    - sample-node.{{hostname.public}}
    httpRoute:
      enabled: true
  podLabels:
    sidecar.istio.io/inject: "true"
  podAnnotations:
    link.argocd.argoproj.io/external-link: https://sample-node.{{hostname.public}}
  serviceMonitor:
    enabled: true
    labels:
      release: prometheus-eks-demo
  externalSecrets:
    data:
    - key: /k8s/common/sample-node/redis-password
      name: REDIS_PASS

redis:
  istio:
    sidecar:
      inject: true

thumbs:
  command:
    - /bin/sh
    - -c
    - >-
      if [ "$(awk 'BEGIN{srand();print int(rand()*2)}')" = 0 ];
      then SIDE=up; else SIDE=down; fi;
      curl -s -o /dev/null
      -w "thumbs $SIDE %{http_code} %{time_total}s %{errormsg}\n"
      -X POST http://sample-node.{{hostname.public}}/counter/$SIDE;
      exit 0
