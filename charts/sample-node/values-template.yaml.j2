{% set redis_config = sample_node.redis if sample_node is defined and sample_node.redis is defined else {} -%}
{% set redis_enabled = redis_config.enabled | default(true) -%}
app:
  replicaCount: {{replicas}}
  autoscaling:
    enabled: {{autoscaling}}
{% if not resources %}
  resources: null
{% endif %}
  configmap:
    data:
      CLUSTER_NAME: '{{cluster}}'
      HOSTNAME: sample.svc.cluster.local
      MESSAGE: hello world
      PROFILE: '{{env}}'
      PROTOCOL: http
      REDIS_ENABLED: '{{ redis_enabled | lower }}'
{% if redis_enabled %}
      REDIS_HOST: redis-master
      REDIS_PORT: '6379'
{% endif %}
  routing:
    hosts:
    - sample-node.{{hostname.public}}
    httpRoute:
      enabled: true
{% if env == 'k3s' %}
      parentRefs:
        - name: traefik-gateway
          namespace: traefik-gateway
{% endif %}
{% if env != 'k3s' %}
  podLabels:
    sidecar.istio.io/inject: "true"
{% endif %}
  podAnnotations:
    link.argocd.argoproj.io/external-link: https://sample-node.{{hostname.public}}
  serviceMonitor:
    enabled: {{ (metrics is defined and metrics.backend == 'prometheus') | lower }}
    labels:
      release: prometheus-{{cluster}}
  externalSecrets:
    enabled: {{ redis_enabled | lower }}
{% if redis_enabled %}
    data:
    - key: /k8s/common/sample-node/redis-password
      name: REDIS_PASS
{% else %}
    data: []
{% endif %}

redis:
  enabled: {{ redis_enabled | lower }}
  global:
    storageClass: {{ redis_config.storageClass | default('local-path' if env in ['k3s', 'local'] else 'gp3') }}
  istio:
    sidecar:
      inject: true
{% if not resources %}
  resources: null
{% endif %}
  master:
    persistence:
      enabled: true
      size: {{ redis_config.storage | default('1Gi' if env in ['k3s', 'local'] else '8Gi') }}
{% if not resources %}
    resources: null
{% endif %}
