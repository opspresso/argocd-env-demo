{% set maintenance = agent_forge_maintenance | default(false) -%}
app:
  fullnameOverride: agent-forge
  raw:
    enabled: {{agent_forge is defined}}
{% if agent_forge is defined %}
  replicaCount: {{0 if maintenance else replicas}}
  autoscaling:
    enabled: {{false if maintenance else autoscaling}}
  image:
    repository: {{aws_account_id}}.dkr.ecr.{{aws_region}}.amazonaws.com/agent-forge
  imagePullSecrets:
    - name: ecr-registry
{% if not resources %}
  resources: null
{% endif %}
  ingressPeers:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{'kube-system' if env == 'k3s' else 'istio-system'}}
{% if env == 'k3s' %}
      podSelector:
        matchLabels:
          app.kubernetes.io/name: traefik
          app.kubernetes.io/instance: traefik-kube-system
{% endif %}
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{'addon-alloy' if env == 'k3s' else 'addon-prometheus'}}
  registry:
    region: {{aws_region}}
  ssmPrefix: /k8s/{{cluster}}
  configmap:
    enabled: true
    data:
      HOST: 0.0.0.0
      PORT: '3103'
      FORGE_ALLOWED_ORIGINS: https://{{agent_forge.hostname}}
      FORGE_WORKER: 'true'
      FORGE_SANDBOX_PROVIDER: kubernetes
      FORGE_KUBE_IMAGE_PULL_SECRET: ecr-registry
      FORGE_KUBE_NODE_POOL: '{{ "workspaces" if env == "eks" else "" }}'
      FORGE_GIT_ALLOWED_ORIGINS: https://github.com
  sandbox:
    namespace: agent-forge-workspaces
    maxPods: {{workspace_max_pods | default(2)}}
    memoryMb: {{workspace_memory_mb | default(1024)}}
    diskMb: {{workspace_disk_mb | default(2048)}}
    cpus: {{workspace_cpus | default(1)}}
    dnsCidrs:
      - {{ '172.20.0.10/32' if env == 'eks' else '10.43.0.10/32' }}
    allowPublic: {{workspace_allow_public | default(true)}}
    extraEgress: {{workspace_extra_egress | default([]) | tojson}}
  routing:
    hosts:
    - {{agent_forge.hostname}}
    httpRoute:
      enabled: true
{% if env == 'k3s' %}
      parentRefs:
        - name: traefik-gateway
          namespace: traefik-gateway
{% endif %}
{% if env != 'k3s' %}
  podLabels:
    sidecar.istio.io/inject: "true"
{% endif %}
  podAnnotations:
    link.argocd.argoproj.io/external-link: https://{{agent_forge.hostname}}
  externalSecrets:
    enabled: true
    data:
    - key: /k8s/{{cluster}}/agent-platform/database-url
      name: DATABASE_URL
    - key: /k8s/{{cluster}}/agent-forge/credentials
      name: FORGE_CREDENTIALS
    - key: /k8s/{{cluster}}/agent-forge/delegators
      name: FORGE_DELEGATORS
    - key: /k8s/{{cluster}}/agent-forge/issuer-policies
      name: FORGE_ISSUER_POLICIES
    - key: /k8s/{{cluster}}/agent-forge/checkpoint-secret
      name: FORGE_CHECKPOINT_SECRET
    - key: /k8s/{{cluster}}/agent-forge/credential-secret
      name: FORGE_CREDENTIAL_SECRET
    - key: /k8s/{{cluster}}/agent-forge/model-secret
      name: FORGE_MODEL_SECRET
    - key: /k8s/{{cluster}}/agent-forge/model-channels
      name: FORGE_MODEL_CHANNELS
  serviceMonitor:
    enabled: {{ (metrics is defined and metrics.backend == 'prometheus') | lower }}
    labels:
      release: prometheus-{{cluster}}
{% endif %}
