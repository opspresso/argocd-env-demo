app:
  podLabels:
    sidecar.istio.io/inject: "true"

  # No MCP_API_KEY, for the same reason url-fetch has none: nothing routes to
  # this Service from outside. The server says which mode it is in on every
  # start, so the day an ingress appears the open mode is in the logs.
  #
  # No AWS credentials either. The ServiceAccount below is bound to
  # pod-role--mcp-memory by an EKS Pod Identity association, defined in
  # terraform-env-demo/demo/4-role. Pod Identity needs no annotation on the
  # ServiceAccount — unlike IRSA — so the only requirement here is that the
  # account exists under exactly the name the association names.
  configmap:
    enabled: true
    data:
      AWS_REGION: ap-northeast-2
      # DATABASE_URL comes from the phase's mcp-memory external secret. It must
      # point at PostgreSQL with pgvector; the server creates its own schema on
      # boot. Keep this database separate from Agent Studio's application data.
      # Bedrock needs no key because the pod role covers it.
      EMBEDDING_PROVIDER: bedrock
      EMBEDDING_MODEL: amazon.titan-embed-text-v2:0
      EMBEDDING_DIM: '1024'
      # The relevance floor, and the one setting that belongs to the embedding
      # model rather than to the server: calibrated against measured Titan
      # similarities, where a correct answer scores 0.15-0.41 and an unrelated
      # one under 0.05. Changing EMBEDDING_MODEL means recalibrating this.
      RECALL_MIN_SIMILARITY: '0.1'
