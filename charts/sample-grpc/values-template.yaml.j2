app:
  replicaCount: {{replicas}}
  autoscaling:
    enabled: {{autoscaling}}
{% if not resources %}
  resources: null
{% endif %}
  configmap:
    data:
      CLUSTER_NAME: '{{cluster}}'
      MESSAGE: hello world
      PROFILE: '{{env}}'
  routing:
    hosts:
    - sample-grpc.{{hostname.public}}
    httpRoute:
      enabled: true
{% if env == 'k3s' %}
      parentRefs:
        - name: traefik-gateway
          namespace: traefik-gateway
{% endif %}
{% if env != 'k3s' %}
  podLabels:
    sidecar.istio.io/inject: "true"
{% endif %}
  podAnnotations:
    link.argocd.argoproj.io/external-link: https://sample-grpc.{{hostname.public}}
  serviceMonitor:
    enabled: {{ (metrics is defined and metrics.backend == 'prometheus') | lower }}
    labels:
      release: prometheus-{{cluster}}
